# Copy to .env for local overrides. Nothing here is required for a build.

# Show the sample listings / testimonials (marked `sample: true` in src/data/*.js)
# in a production build. They always show in `npm run dev`; they are hidden in
# `npm run build` unless this is "true". Leave unset on Netlify.
# PUBLIC_SHOW_SAMPLE_CONTENT=true

# MLS / Listing API (if integrated later)
# MLS_API_KEY=
