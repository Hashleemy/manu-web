---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<button
  id="lang-toggle"
  class={`lang-toggle relative inline-flex items-center gap-1.5 px-4 py-2 md:py-1.5 min-h-[40px] rounded-full border border-warm-charcoal/20 font-body text-xs font-medium text-warm-charcoal hover:border-gold-leaf hover:text-gold-leaf transition-all duration-200 cursor-pointer ${className}`}
>
  <span class="lang-toggle-en font-semibold text-deep-forest">EN</span>
  <span class="text-warm-charcoal/40 select-none" aria-hidden="true">|</span>
  <span class="lang-toggle-es">ES</span>
  <span class="sr-only">— Switch language / Cambiar idioma</span>
</button>

<!-- aria-live region for screen readers -->
<div aria-live="polite" aria-atomic="true" class="sr-only" id="lang-announce"></div>

<script>
  import { gsap } from 'gsap';

  const toggle = document.getElementById('lang-toggle') as HTMLButtonElement;
  const announce = document.getElementById('lang-announce') as HTMLDivElement;
  const enLabel = toggle.querySelector('.lang-toggle-en') as HTMLSpanElement;
  const esLabel = toggle.querySelector('.lang-toggle-es') as HTMLSpanElement;

  function updateToggleVisuals(isEs: boolean) {
    enLabel.style.fontWeight = isEs ? '400' : '600';
    enLabel.style.color = isEs ? '' : '#2C4A3E';
    esLabel.style.fontWeight = isEs ? '600' : '400';
    esLabel.style.color = isEs ? '#2C4A3E' : '';
    announce.textContent = isEs ? 'Idioma cambiado a Español' : 'Language changed to English';
    window.dispatchEvent(new CustomEvent('langchange', { detail: { lang: isEs ? 'es' : 'en' } }));
  }

  function setActive(isEs: boolean) {
    document.documentElement.classList.toggle('is-es', isEs);
    document.documentElement.setAttribute('lang', isEs ? 'es' : 'en');
    localStorage.setItem('lang', isEs ? 'es' : 'en');
    const t = document.documentElement.dataset[isEs ? 'titleEs' : 'titleEn'];
    if (t) document.title = t;
    updateToggleVisuals(isEs);
  }

  // Init from current html class (set by inline script in Layout.astro) — no animation on init
  setActive(document.documentElement.classList.contains('is-es'));

  toggle.addEventListener('click', () => {
    const willBeEs = !document.documentElement.classList.contains('is-es');

    // Crossfade: fade in the incoming language after CSS toggles display
    setActive(willBeEs);
    const inEls = document.querySelectorAll<HTMLElement>(willBeEs ? '.lang-es' : '.lang-en');
    gsap.fromTo(inEls, { opacity: 0 }, { opacity: 1, duration: 0.2, ease: 'power1.out', overwrite: 'auto' });
  });
</script>
