---
interface Props {
  class?: string;
  size?: 'sm' | 'md';
}
const { class: className = '', size = 'md' } = Astro.props;

const sizeClasses = {
  sm: 'px-4 py-2 text-xs gap-2',
  md: 'px-5 py-3 text-sm gap-3',
};
---

<!--
  Text-based Berkshire Hathaway badge.
  Replace with official logo asset once brand guidelines are confirmed (Open Question #5).
-->
<div
  class={`inline-flex items-center border border-gold-leaf rounded-full font-body font-medium text-deep-forest tracking-wider ${sizeClasses[size]} ${className}`}
  role="img"
  aria-label="Berkshire Hathaway HomeServices"
>
  <!-- Diamond mark placeholder — replace with official SVG logo -->
  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
    <path
      d="M 8 1 L 15 8 L 8 15 L 1 8 Z"
      fill="none"
      stroke="#C9A96E"
      stroke-width="1.5"
    />
    <path d="M 8 4 L 12 8 L 8 12 L 4 8 Z" fill="#C9A96E" opacity="0.4" />
  </svg>
  <span class="uppercase">Berkshire Hathaway HomeServices</span>
</div>
