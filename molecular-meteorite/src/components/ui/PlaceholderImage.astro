---
interface Props {
  slot?: string;
  label?: string;
  aspectRatio?: string;
  class?: string;
}
const {
  slot: slotName = 'image',
  label,
  aspectRatio = '4/3',
  class: className = '',
} = Astro.props;

const displayLabel = label ?? slotName;
---

<!--
  Placeholder for images not yet received from Manuela.
  Replace <PlaceholderImage> with <Image> or <img> once assets arrive.
  slot prop identifies which image is needed (matches Open Question #1 tracking).
-->
<div
  class={`placeholder-image relative flex flex-col items-center justify-center bg-cream-ivory border-2 border-dashed border-gold-leaf/40 rounded-2xl overflow-hidden text-center ${className}`}
  style={`aspect-ratio: ${aspectRatio};`}
  data-slot={slotName}
  aria-label={`Image placeholder: ${displayLabel}`}
  role="img"
>
  <!-- Decorative flower mark -->
  <svg viewBox="0 0 40 40" width="36" height="36" aria-hidden="true" class="mb-3 opacity-30">
    {[0, 60, 120, 180, 240, 300].map((angle) => (
      <path
        d="M 20 18 C 14 15 13 9 20 6 C 27 9 26 15 20 18 Z"
        fill="#C9A96E"
        transform={`rotate(${angle}, 20, 20)`}
      />
    ))}
    <circle cx="20" cy="20" r="4" fill="#C9A96E" opacity="0.5" />
  </svg>

  <p class="font-body text-xs text-warm-charcoal/75 px-4 leading-snug">
    <span class="block font-medium text-warm-charcoal/90 mb-0.5">[ {displayLabel} ]</span>
    Photo coming soon
  </p>
</div>
