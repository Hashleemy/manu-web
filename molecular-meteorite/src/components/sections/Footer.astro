---
import BougainvilleaFull from '../BougainvilleaFull.astro';
import { en } from '../../i18n/en.js';
import { es } from '../../i18n/es.js';
import { site, socialLinks } from '../../data/site.js';

const socials = socialLinks();
const year = new Date().getFullYear();
const brokerageLine = [site.brokerage, site.office].filter(Boolean).join(' ');

const navLinks = [
  { href: '#home',      en: 'Home',      es: 'Inicio'      },
  { href: '#about',     en: 'About',     es: 'Sobre Mí'    },
  { href: '#services',  en: 'Services',  es: 'Servicios'   },
  { href: '#listings',  en: 'Listings',  es: 'Propiedades' },
  { href: '#contact',   en: 'Contact',   es: 'Contacto'    },
];
---

<footer class="relative bg-deep-forest text-cream-ivory overflow-hidden">

  <!-- Decorative bougainvillea — bottom-right corner -->
  <div class="absolute bottom-0 right-0 opacity-[0.06] pointer-events-none select-none translate-x-1/4 translate-y-1/4" aria-hidden="true">
    <BougainvilleaFull size={320} />
  </div>

  <div class="section-wrapper py-16 md:py-20 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 mb-12">

      <!-- Brand column -->
      <div class="space-y-4">
        <p class="heading-accent text-2xl text-gold-leaf italic">Manuela Maria</p>
        <p class="font-body text-sm text-cream-ivory/75 leading-relaxed text-balance-bi">
          <span class="lang-en">{en.footer.tagline}</span>
          <span class="lang-es">{es.footer.tagline}</span>
        </p>
      </div>

      <!-- Quick nav -->
      <div>
        <p class="font-body text-xs font-semibold text-gold-leaf-light tracking-widest uppercase mb-5">
          <span class="lang-en">{en.footer.quickLinks}</span>
          <span class="lang-es">{es.footer.quickLinks}</span>
        </p>
        <nav aria-label="Footer navigation">
          <ul class="space-y-2.5">
            {navLinks.map(({ href, en: enLabel, es: esLabel }) => (
              <li>
                <a
                  href={href}
                  class="font-body text-sm text-cream-ivory/70 hover:text-gold-leaf transition-colors duration-200"
                >
                  <span class="lang-en">{enLabel}</span>
                  <span class="lang-es">{esLabel}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Social + contact — only links filled in src/data/site.js are rendered -->
      {(socials.length > 0 || site.email || site.phone) && (
      <div class="space-y-5">
        <p class="font-body text-xs font-semibold text-gold-leaf-light tracking-widest uppercase">
          <span class="lang-en">Connect</span>
          <span class="lang-es">Conecta</span>
        </p>
        {socials.length > 0 && (
        <div class="flex gap-4">
          {socials.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            class="w-9 h-9 flex items-center justify-center rounded-full border border-cream-ivory/20 text-cream-ivory/70 hover:border-gold-leaf hover:text-gold-leaf transition-all duration-200"
          >
            {s.key === 'instagram' && <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>}
            {s.key === 'facebook' && <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>}
            {s.key === 'linkedin' && <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>}
          </a>
          ))}
        </div>
        )}
        {(site.email || site.phone) && (
        <ul class="font-body text-sm text-cream-ivory/75 space-y-1.5">
          {site.phone && <li>{site.phone}</li>}
          {site.email && <li><a href={`mailto:${site.email}`} class="hover:text-gold-leaf transition-colors">{site.email}</a></li>}
        </ul>
        )}
      </div>
      )}

    </div>

    <!-- Divider -->
    <div class="border-t border-cream-ivory/10 pt-8 space-y-3">
      <!-- Brokerage disclaimer — assembled from src/data/site.js; wording in i18n footer.* -->
      <p class="font-body text-xs text-cream-ivory/75 leading-relaxed max-w-2xl text-balance-bi">
        <span class="lang-en">{site.name} {en.footer.licensedWith} {brokerageLine}.{site.licenseNumber && ` ${en.footer.licenseLabel} #${site.licenseNumber}.`}{site.officeAddress && ` ${site.officeAddress}.`} {en.footer.equalHousing}</span>
        <span class="lang-es">{site.name} {es.footer.licensedWith} {brokerageLine}.{site.licenseNumber && ` ${es.footer.licenseLabel} #${site.licenseNumber}.`}{site.officeAddress && ` ${site.officeAddress}.`} {es.footer.equalHousing}</span>
      </p>
      <!-- Copyright -->
      <p class="font-body text-xs text-cream-ivory/75">
        © {year} {site.name}.
        <span class="lang-en">{en.footer.copyright}</span>
        <span class="lang-es">{es.footer.copyright}</span>
      </p>
    </div>
  </div>
</footer>
